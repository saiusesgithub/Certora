{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Certora",
  "version": "0.1.0",
  "identifier": "com.certora.app",
  "build": {
    "beforeDevCommand": "npm run backend:install && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run backend:install && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Certora",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../backend"
    ]
  }
}
